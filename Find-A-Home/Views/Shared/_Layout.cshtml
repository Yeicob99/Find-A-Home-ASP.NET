<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Find_A_Home</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site-header.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Find_A_Home.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/property-card.css" asp-append-version="true" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="estancia-header">
        <nav class="estancia-navbar">
            <div class="estancia-container">
                <a asp-controller="Home" asp-action="Index" class="estancia-brand">
                    <i class="bi bi-building"></i>
                    <span>Estancia</span>
                </a>
                <ul class="estancia-nav-links">
                    <li>
                        <a asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li>
                        <a asp-controller="Properties" asp-action="Index">Discover</a>
                    </li>
                    <li>
                        <a asp-controller="Properties" asp-action="Index">Dashboard</a>
                    </li>
                </ul>
                <div class="estancia-auth">
                    <a href="#" class="estancia-login-icon">
                        <i class="bi bi-person"></i>
                    </a>
                    <a href="#" class="estancia-login">
                        Ingresar
                    </a>
                    <a href="#" class="estancia-register">
                        Crear cuenta
                    </a>
                </div>
            </div>
        </nav>
        <div class="estancia-bottom-bar"></div>
    </header>
        <main role="main">
            @RenderBody()
        </main>
    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Find_A_Home - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
